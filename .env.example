# Required in production: 32+ random characters. Encrypts stored provider tokens.
APP_SECRET=

# libSQL database. Defaults to a local file (file:data/aicooldown.db) when unset.
# On serverless hosts use Turso or another libSQL server.
LIBSQL_URL=
# (Vercel's Turso integration sets TURSO_DATABASE_URL and TURSO_AUTH_TOKEN instead; both names work.)
# `npm run dev` ignores a database server here and keeps to the local file, unless AICOOLDOWN_REMOTE_DB=1.
LIBSQL_AUTH_TOKEN=
